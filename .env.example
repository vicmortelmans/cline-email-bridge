# Copy this file to .env and edit it. Keep .env out of version control.

# IMAP mailbox
IMAP_HOST=imap.example.net
IMAP_PORT=993
IMAP_SSL=true
IMAP_USERNAME=cline@example.net
IMAP_PASSWORD=replace-with-mailbox-password
IMAP_FOLDER=INBOX

# Optional: after successful processing, move messages here.
# Leave empty to keep them in INBOX and only mark them as read.
IMAP_PROCESSED_FOLDER=Processed/Cline

# Security: only messages whose From address matches one of these addresses
# will be processed. Comma-separated; do not leave empty.
ALLOWED_SENDERS=you@example.net

# Store each original email, attachments, logs and results OUTSIDE the project.
TASKS_DIR=/home/your-user/cline-email-tasks

# Cline CLI
CLINE_BIN=cline
CLINE_PROVIDER=openrouter
# Optional. Leave empty to use the provider's configured default model.
CLINE_MODEL=
# Cline's working directory; use the project directory if you want project skills/rules.
CLINE_WORKDIR=/home/your-user/path/to/your/project
CLINE_TIMEOUT_SECONDS=3600

# IMPORTANT: false is safer, but unattended tasks may stop when a tool needs approval.
# Set true only when you are comfortable with Cline approving tool actions unattended.
CLINE_AUTO_APPROVE=false

# Operational settings
MAX_EMAILS_PER_RUN=5
LOG_LEVEL=INFO
